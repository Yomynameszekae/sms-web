# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated screenshots (used to build PDF, not part of source)
screenshots-guide/

# Binary PDF artifacts (regenerable from source)
BRITE_SMS_PHASE_1_USER_GUIDE.pdf
BRITE_SMS_TUTORIAL.pdf

# Design prototype files (large, not part of deployable app)
BriteRedesignFiles/
